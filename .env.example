# Mot de passe de la console admin (obligatoire)
ADMIN_PASSWORD=change-me-please

# Secret de signature des sessions. A defaut, ADMIN_PASSWORD sert de secret.
# Mets une valeur longue et aleatoire, et ne la change pas sauf pour invalider toutes les sessions.
SESSION_SECRET=another-long-random-string

# Stockage. En local, laisse ces variables vides : l'app ecrit dans ./data/portfolio.json.
# Sur Vercel, le store Blob connecté en OIDC fournit BLOB_STORE_ID + VERCEL_OIDC_TOKEN
# automatiquement (voir README) : rien a mettre ici.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
